package cbom.eccg.asymmetric_constructions.asymmetric_encryption_schemes

import data.cbom.eccg.general_helpers.build_finding
import data.cbom.eccg.getter_helpers.get_note
import data.cbom.eccg.getter_helpers.get_component_name_or_empty

import data.cbom.eccg.asymmetric_constructions.asymmetric_encryption_schemes.constants.AGREED_ASYMMETRIC_ENCRYPTION_SCHEMES
import data.cbom.eccg.asymmetric_constructions.asymmetric_encryption_schemes.helpers.asymmetric_encryption_metadata
import data.cbom.eccg.asymmetric_constructions.asymmetric_encryption_schemes.helpers.is_asymmetric_encryption_component
import data.cbom.eccg.asymmetric_constructions.asymmetric_encryption_schemes.helpers.is_agreed_asymmetric_encryption_scheme
import data.cbom.eccg.asymmetric_constructions.asymmetric_encryption_schemes.helpers.is_oaep_scheme
import data.cbom.eccg.asymmetric_constructions.asymmetric_encryption_schemes.helpers.is_pkcs1_v1_5_scheme

SECTION := "Asymmetric-Constructions"
SUBSECTION := "Asymmetric-Encryption-Schemes"

# ECCG-AS-ENC-001: An asymmetric encryption scheme is not in the agreed list.
findings contains finding if {
	some component in input.components
	is_asymmetric_encryption_component(component)
	not is_agreed_asymmetric_encryption_scheme(component)

	finding := build_finding(
		"ECCG-AS-ENC-001",
		"critical",
		sprintf("Asymmetric encryption scheme '%s' is not in the ECCG agreed scheme list. The agreed asymmetric encryption schemes are: %s.", [get_component_name_or_empty(component), concat(", ", sort(AGREED_ASYMMETRIC_ENCRYPTION_SCHEMES))]),
		component,
		asymmetric_encryption_metadata(component),
	)
}

# ECCG-AS-ENC-002: Both agreed schemes require randomized padding.
findings contains finding if {
	some component in input.components
	is_agreed_asymmetric_encryption_scheme(component)
	metadata := asymmetric_encryption_metadata(component)

	finding := build_finding(
		"ECCG-AS-ENC-002",
		"warning",
		sprintf("%s detected. Ensure that randomized padding is generated by an agreed random bit generator.", [metadata.schemeIdentifier]),
		component,
		object.union(metadata, {"notes": get_note(SECTION, SUBSECTION, "43-RandomPadding")}),
	)
}

# ECCG-AS-ENC-003: Review PKCS#1 v1.5 padding-oracle protections.
findings contains finding if {
	some component in input.components
	is_pkcs1_v1_5_scheme(component)

	finding := build_finding(
		"ECCG-AS-ENC-003",
		"warning",
		"RSAES-PKCS1-v1_5 is vulnerable to efficient attacks when a padding oracle is available. Verify that the implementation prevents padding-oracle exposure.",
		component,
		object.union(asymmetric_encryption_metadata(component), {"notes": get_note(SECTION, SUBSECTION, "44-PaddingAttack")}),
	)
}

# ECCG-AS-ENC-004: Review the order of OAEP decoding checks.
findings contains finding if {
	some component in input.components
	is_oaep_scheme(component)

	finding := build_finding(
		"ECCG-AS-ENC-004",
		"warning",
		"RSAES-OAEP detected. Verify that EME-OAEP decoding checks are performed in the specified order; incorrect decoding may expose a padding oracle.",
		component,
		object.union(asymmetric_encryption_metadata(component), {"notes": get_note(SECTION, SUBSECTION, "45-OAEP-PaddingAttack")}),
	)
}

# ECCG-AS-ENC-005: Review quantum resistance for both agreed RSA schemes.
findings contains finding if {
	some component in input.components
	is_agreed_asymmetric_encryption_scheme(component)
	metadata := asymmetric_encryption_metadata(component)

	finding := build_finding(
		"ECCG-AS-ENC-005",
		"warning",
		sprintf("%s relies on RSA, which is vulnerable to quantum attacks, including later decryption of stored ciphertext. Where quantum resistance is required, combine it with a quantum-resistant mechanism.", [metadata.schemeIdentifier]),
		component,
		object.union(metadata, {"notes": get_note(SECTION, SUBSECTION, "46-QuantumThreat")}),
	)
}
