package cbom.eccg.symmetric_constructions.mac
import data.cbom.eccg.getter_helpers.get_component_name_or_empty 
import data.cbom.eccg.getter_helpers.get_component_bom_ref_or_empty
import data.cbom.eccg.getter_helpers.get_note

import data.cbom.eccg.classifying_helpers.is_mac_primitive

import data.cbom.eccg.general_helpers.build_finding

import data.cbom.eccg.symmetric_constructions.macs.helpers.is_agreed_mac_scheme
import data.cbom.eccg.symmetric_constructions.macs.helpers.is_possible_mac_encryption_composition
import data.cbom.eccg.symmetric_constructions.macs.helpers.is_cbcmac_scheme
import data.cbom.eccg.symmetric_constructions.macs.helpers.is_hmac_or_kmac_scheme
import data.cbom.eccg.symmetric_constructions.macs.helpers.is_gmac_scheme
import data.cbom.eccg.symmetric_constructions.macs.helpers.mac_scheme_metadata
import data.cbom.eccg.symmetric_constructions.macs.helpers.AGREED_MAC_ALGORITHM_NAMES

import data.cbom.eccg.symmetric_constructions.macs.constants.MINIMUM_MAC_BITS_TRUNCATED_OUTPUT
import data.cbom.eccg.symmetric_constructions.macs.constants.MINIMUM_RECOMMENDED_BITS_FOR_QUANTUM_SENSITIVE_CONTEXT_MACS
import data.cbom.eccg.symmetric_constructions.macs.constants.GMAC_INITIALIZATION_VECTOR_REQUIRED_BITS
import data.cbom.eccg.symmetric_constructions.macs.constants.GMAC_INITIALIZATION_VECTOR_CONSTRUCTION

default compliant := true compliant if count(findings) == 0

SECTION := "Symmetric-Constructions"
SUBSECTION := "Message-Authentication-Codes"

#
# Rule ECCG-MAC-001
# MAC scheme not listed by ECCG.
#
findings contains finding if {
    component := input.components[_]

    is_mac_primitive(component)
    not is_agreed_mac_scheme(component)

    finding := build_finding(
        "ECCG-MAC-001",
        "critical",
        sprintf("MAC scheme '%s' is not listed in the ECCG agreed or legacy MAC tables. The recommended mac schemes are %s.", [get_component_name_or_empty(component), AGREED_MAC_ALGORITHM_NAMES]),
        component,
        mac_scheme_metadata(component),
    )
}

#
# Rule ECCG-MAC-002
# General MAC truncation requirement.
#
# The output MAC of CMAC, CBC-MAC, HMAC, KMAC128, and KMAC256 must not be
# truncated to less than 96 bits.
#
# This rule is based on Note 15-MACTruncation96:
# Unless stated otherwise explicitly for a given mechanism, truncation of a MAC
# generated by an agreed MAC mechanism to at least 96 bits is agreed.
#
# This rule does not include GMAC. GMAC is handled by ECCG-MAC-004 because the
# notes explicitly state that some MAC mechanisms may require more restrictive
# truncation treatment, notably GMAC.
#
# This rule is classification-based unless the CBOM contains MAC output length
# or tag length metadata. It flags that the implementation must ensure that the
# final MAC/tag length is not below 96 bits.
#
findings contains finding if {
    component := input.components[_]

    is_mac_primitive(component)
    is_agreed_mac_scheme(component)

    note := get_note(SECTION, SUBSECTION, "15-MACTruncation96")

    finding := build_finding(
        "ECCG-MAC-002",
        "warning",
        sprintf("The output %s must not be truncated to less than %d bits.", [AGREED_MAC_ALGORITHM_NAMES, MINIMUM_MAC_BITS_TRUNCATED_OUTPUT]),
        component,
        object.union(
            mac_scheme_metadata(component),
            {
                "notes": note,
            }
        )
    )
}

#
# ---------------------------------------------------------
# ECCG-HMAC-001: Quantum Security of HMAC/KMAC
#
# ECCG Reference: Note 19-QuantumThreat
#
# Quantum algorithms, such as Grover's algorithm, may reduce
# the computational complexity of attacks against symmetric
# cryptographic constructions, including MAC schemes.
#
# For applications requiring resistance against quantum
# attacks, the ECCG recommends MAC keys of at least 192 bits.
#
# This rule identifies HMAC and KMAC constructions and
# generates an advisory finding concerning their use in
# quantum-sensitive environments.
#
# Limitations:
# - Does not verify the actual MAC key length.
# - Does not determine whether quantum resistance is required.
# - A finding does not necessarily indicate noncompliance.
#
# ---------------------------------------------------------
#
findings contains finding if {
    component := input.components[_]

    is_mac_primitive(component)
    is_hmac_or_kmac_scheme(component)

    note := get_note(SECTION, SUBSECTION, "19-QuantumThreat")

    finding := build_finding(
        "ECCG-HMAC-001",
        "medium",
        sprintf("For %s in quantum-sensitive contexts, verify that the actual key size is at least %d bits. The algorithm name and MAC output length do not establish the key size.", [get_component_name_or_empty(component), MINIMUM_RECOMMENDED_BITS_FOR_QUANTUM_SENSITIVE_CONTEXT_MACS]),
        component,
        object.union(
            mac_scheme_metadata(component),
            {
                "notes": note,
            }
        )
    )
}

#
# ---------------------------------------------------------
# ECCG-CBC-MAC-001: CBC-MAC Fixed Input Length
#
# ECCG Reference: Note 17-FixedInputLength
#
# CBC-MAC provides message authentication using a block
# cipher operating in CBC mode.
#
# Basic CBC-MAC is secure only under specific conditions,
# particularly when all messages authenticated under the
# same key have identical lengths.
#
# Authenticating variable-length messages under the same
# key may enable length-extension forgery attacks, allowing
# an adversary to construct valid authentication tags for
# unauthorized messages.
#
# The ECCG therefore agrees to CBC-MAC only when the
# fixed-input-length requirement is satisfied.
#
# This rule identifies CBC-MAC constructions and reports
# the need to verify this restriction.
#
# Limitations:
# - Does not inspect the lengths of authenticated messages.
# - Does not verify key reuse across different input lengths.
# - Does not establish that a forgery vulnerability exists.
#
# ---------------------------------------------------------
#
findings contains finding if {
    component := input.components[_]

    is_mac_primitive(component)
    is_cbcmac_scheme(component)

    note := get_note(SECTION, SUBSECTION, "17-FixedInputLength")

    finding := build_finding(
        "ECCG-CBC-MAC-001",
        "warning",
        sprintf("CBC MAC scheme detected: %s. Ensure the outputs follow a fixed input length.", [get_component_name_or_empty(component)]),
        component,
        object.union(
            mac_scheme_metadata(component),
            {
                "notes": note,
            }
        )
    )
}

#
# ---------------------------------------------------------
# ECCG-GMAC-001: GMAC Nonce Management
#
# ECCG Reference: Note 22-GMAC-GCMNonce
#
# GMAC is a message authentication construction derived
# from GCM, providing authentication without encryption.
#
# Its security relies on correct initialization vector
# (IV/nonce) management.
#
# Reusing the same IV with the same secret key to authenticate
# different plaintext and associated-data combinations can
# undermine the authentication guarantees and enable forgery
# attacks.
#
# The ECCG requires IV management to remain within the
# security perimeter of the authenticated encryption process.
# In particular, adversaries must not be able to cause
# IV reuse under the same key.
#
# This rule identifies GMAC constructions and reports the
# requirement for secure nonce management.
#
# Limitations:
# - Does not inspect the actual IV values.
# - Does not verify IV uniqueness under the same key.
# - Does not determine whether an adversary controls IVs.
# - Does not establish that nonce reuse has occurred.
#
# ---------------------------------------------------------
#
findings contains finding if {
    component := input.components[_]

    is_mac_primitive(component)
    is_gmac_scheme(component)

    note := get_note(SECTION, SUBSECTION, "22-GMAC-GCMNonce")

    finding := build_finding(
        "ECCG-GMAC-001",
        "warning",
        sprintf("GMAC scheme detected: %s. Ensure the security of the IV.", [get_component_name_or_empty(component)]),
        component,
        object.union(
            mac_scheme_metadata(component),
            {
                "notes": note,
            }
        )
    )
}

#
# ---------------------------------------------------------
# ECCG-GMAC-002: GMAC/GCM Configuration Requirements
#
# ECCG Reference: Note 23-GMAC-GCMOptions
#
# GCM and its authentication-only variant, GMAC, support
# different configuration options concerning IV generation,
# IV length, and authentication tag length.
#
# Although the underlying standards permit multiple
# configurations, the ECCG restricts acceptable configurations
# to a specific set of parameters.
#
# The agreed configuration requires:
#
# - An initialization vector (IV) of exactly 96 bits.
# - The deterministic IV construction method defined in
#   NIST SP 800-38D, Section 8.2.1.
# - An authentication tag length of exactly 128 bits.
#
# These restrictions establish a consistent configuration
# intended to preserve the security guarantees of GCM/GMAC
# and reduce risks associated with inappropriate IV generation
# and authentication tag configurations.
#
# This rule identifies GMAC constructions and reports the
# need to verify compliance with these configuration
# requirements.
#
# Limitations:
# - Does not inspect the actual IV length.
# - Does not verify the IV construction method.
# - Does not inspect the actual authentication tag length.
# - Does not establish that the configuration is noncompliant.
#
# ---------------------------------------------------------
#
findings contains finding if {
    component := input.components[_]

    is_mac_primitive(component)
    is_gmac_scheme(component)

    note := get_note(SECTION, SUBSECTION, "23-GMAC-GCMOptions")

    finding := build_finding(
        "ECCG-GMAC-002",
        "warning",
        sprintf("GMAC scheme detected: %s. Ensure the agreed upon %d bits of the IV and the appropriate construction %s.", [get_component_name_or_empty(component), GMAC_INITIALIZATION_VECTOR_REQUIRED_BITS, GMAC_INITIALIZATION_VECTOR_CONSTRUCTION]),
        component,
        object.union(
            mac_scheme_metadata(component),
            {
                "notes": note,
            }
        )
    )
}

#
# ---------------------------------------------------------
# ECCG-GMAC-003: GMAC/GCM Authentication Tag Length
#
# ECCG Reference: Note 25-GMAC-GCM-Bounds
#
# GMAC and GCM rely on authentication tags to detect
# unauthorized modifications and prevent message forgery.
#
# The security of these constructions is characterized by
# unforgeability bounds that depend on several factors,
# including the authentication tag length, the number of
# forgery attempts, and the amount of authenticated data.
#
# These bounds are not optimal, meaning that the probability
# of successful forgery cannot be characterized solely by
# the ideal probability of guessing a random authentication
# tag of the same length.
#
# Truncating authentication tags further reduces the
# resistance of the construction against forgery attempts.
#
# The ECCG therefore requires GMAC and GCM to use an
# authentication tag of at least 128 bits. Since the maximum
# native GCM tag length is 128 bits, this effectively requires
# the full-length tag without truncation.
#
# This rule identifies GMAC constructions and reports the
# requirement to preserve the full authentication tag.
#
# Limitations:
# - Does not inspect the actual authentication tag length.
# - Does not verify whether tag truncation is performed.
# - Does not evaluate the quantitative forgery bounds.
# - Does not establish that a forgery vulnerability exists.
#
# ---------------------------------------------------------
#
findings contains finding if {
    component := input.components[_]

    is_mac_primitive(component)
    is_gmac_scheme(component)

    note := get_note(SECTION, SUBSECTION, "25-GMAC-GCM-Bounds")

    finding := build_finding(
        "ECCG-GMAC-003",
        "warning",
        sprintf("GMAC scheme detected: %s. Do not truncate the output tag of GMAC.", [get_component_name_or_empty(component)]),
        component,
        object.union(
            mac_scheme_metadata(component),
            {
                "notes": note,
            }
        )
    )
}

# ------------------------------------------------------------
# ECCG-AE-001
# Potential non-agreed encryption/MAC composition.
#
# ECCG Section 3.5 recommends Encrypt-then-MAC, while
# MAC-then-Encrypt and Encrypt-and-MAC are marked L[2025].
#
# Detection heuristic:
# 1. Identify a symmetric encryption primitive.
# 2. Identify a MAC primitive.
# 3. Check whether their source-code occurrences are within
#    the configured line-distance window in the same file.
#
# Example:
#   crypto.py:20 -> AES-CBC
#   crypto.py:27 -> HMAC-SHA256
#
# These occurrences may indicate:
#   - MAC-then-Encrypt (not agreed after 2025)
#   - Encrypt-and-MAC  (not agreed after 2025)
#   - Encrypt-then-MAC (recommended)
#
# Source-code proximity cannot distinguish these schemes.
# Therefore, report a warning requiring manual verification,
# not a confirmed compliance violation.
# ------------------------------------------------------------
findings contains finding if {
    some component_a in input.components
    some component_b in input.components

    is_possible_mac_encryption_composition(
        component_a,
        component_b
    )

    finding := build_finding(
        "ECCG-MAC-001",
        "warning",
        sprintf(
            "Encryption primitive '%s' and MAC primitive '%s' occur in close source-code proximity. Verify that the implementation uses an ECCG-agreed composition, meaning Encrypt-then-MAC.",
            [get_component_name_or_empty(component_a), get_component_name_or_empty(component_b)]
        ),
        component_a,
        object.union(
            mac_scheme_metadata(component_b),
            {
                "status": "composition-unverified",
                "relatedComponent": get_component_bom_ref_or_empty(component_b),
                "method": "occurrence-proximity",
                "heuristic": true
            }
        )
    )
}
