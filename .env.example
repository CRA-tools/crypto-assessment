# Copy this file to .env and update the values before starting Docker Compose.

# CBOMkit container image tag.
CBOMKIT_VERSION=latest

# Database credentials shared by PostgreSQL and the CBOMkit backend.
POSTGRESQL_AUTH_USERNAME=cbomkit
POSTGRESQL_AUTH_PASSWORD=replace-with-a-strong-password

# Frontend browser origin allowed by the backend and OPA proxy.
# For remote access, replace localhost with your server's hostname or IP.
# Include the scheme and port, with no path or trailing slash.
CBOMKIT_FRONTEND_URL_CORS=http://localhost:8000
